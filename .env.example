# Copy this file to .env and fill in your own keys.  NEVER commit .env.
#   cp .env.example .env
# Every key is optional: without it the system falls back to a local version.

# Exa web search - https://dashboard.exa.ai  (header: x-api-key)
EXA_API_KEY=

# past.dev shared memory - project key from app.past.dev, starts with past_sk_
PAST_API_KEY=

# Claude, for the research agent (workstream 2)
ANTHROPIC_API_KEY=

# Modal uses `modal token new` (stored in ~/.modal.toml), not this file.
# For Modal containers use: modal secret create autoresearch-keys EXA_API_KEY=... PAST_API_KEY=...

# Exa stop loss (our code refuses to call Exa past either limit)
EXA_BUDGET_USD=5
EXA_MAX_CALLS=200

# EinsteinArena (WS1). GET requests are public; the key is only needed for writes
# (submissions, threads, replies, votes).
EINSTEIN_ARENA_API_KEY=
EINSTEIN_ARENA_BASE_URL=https://einsteinarena.com
