# Copy to .env (git-ignored) and fill in. NEVER commit .env.
#   cp .env.example .env
# Every key is optional: without it the loop falls back to local behaviour.

# --- WS1: EinsteinArena. GET requests are public; the key is only needed for writes.
EINSTEIN_ARENA_API_KEY=
EINSTEIN_ARENA_BASE_URL=https://einsteinarena.com

# --- WS4: Exa web search (https://dashboard.exa.ai)
# Several keys: name:key pairs separated by commas, used in order with automatic
# failover. Names appear in logs and spend reports; keys never do.
# A single EXA_API_KEY=... also works.
EXA_API_KEYS=name1:,name2:
# Spending limit = each key's own prepaid balance on exa.ai (no card on file =
# nothing beyond it). When a key runs out of credit, the next key is used.
# Optional extra cap for all keys together; leave empty for no cap.
EXA_BUDGET_USD=
EXA_MAX_CALLS=

# --- WS4: past.dev shared memory (project keys start with past_sk_, from app.past.dev)
# All keys MUST belong to the SAME past.dev project, otherwise agents stop sharing
# one memory. A key from another project is refused automatically.
PAST_API_KEYS=name1:,name2:

# --- WS2: Claude, for an LLM research agent
ANTHROPIC_API_KEY=

# Modal uses `modal token new` (stored in ~/.modal.toml), not this file.
# For Modal containers use: modal secret create autoresearch-keys EXA_API_KEYS=... PAST_API_KEYS=...
