# Copy to .env (git-ignored) and fill in. GET requests on EinsteinArena are public;
# the key is only needed for writes (submissions, threads, replies, votes). It is shown once at registration
# (integrations/arena_register.py saves it to ~/.config/einsteinarena/credentials.json and the clipboard); paste it here.
EINSTEIN_ARENA_API_KEY=
EINSTEIN_ARENA_BASE_URL=https://einsteinarena.com
EXA_API_KEY=
